{
  "name": "hexlens",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "profile:release": "node --expose-gc --import tsx scripts/profile-release.ts",
    "audit:release": "playwright test tests/browser/release-audit.spec.ts",
    "test": "node --import tsx --test tests/**/*.test.ts",
    "test:browser": "playwright test",
    "test:all": "npm test && npm run test:browser"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.56.1",
    "@types/node": "^22.18.6",
    "tsx": "^4.20.3",
    "typescript": "^5.9.2",
    "vite": "^7.1.4"
  },
  "dependencies": {
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0"
  }
}
